# Настройки dubpipe-worker в Docker. Скопируйте в .env рядом с compose.yaml.

# Порт сервиса на этой машине; тот же порт — в DubPipe (server.worker_port).
DUBPIPE_WORKER_PORT=8770

# 1 — голоса актёров (X-Voice и проверка — около 3 ГБ весов при первом запуске), 0 — без них.
DUBPIPE_CLONE=1

# Где ComfyUI и Ollama, если они есть на этой машине: сервис выгружает их
# простаивающие модели, когда видеопамяти не хватает. Нет их — не мешает.
DUBPIPE_COMFYUI=http://host.docker.internal:8188
DUBPIPE_OLLAMA=http://host.docker.internal:11434

# Порт Ollama в контейнере (только с --profile ollama).
OLLAMA_PORT=11434
