# DubPipe — конфигурация (ТЗ §5.3)
# Все поля необязательны: пропущенное берётся из значения по умолчанию.
# Создать рабочую копию: dub config init

# Профиль исполнения (ТЗ §15).
#   offline — ничего не уходит в сеть после загрузки моделей, ключи не нужны
#   hybrid  — то же самое, но перевод (S3) идёт через Kilo Gateway
profile: hybrid

input: null            # путь или YouTube-URL; переопределяется аргументом CLI
output: null           # итоговый файл; переопределяется флагом --out
keep_original_track: false   # вторая аудиодорожка с оригиналом

# --- Шлюз ИИ (используется только стадией S3) --------------------------------
# ВАЖНО (ТЗ §3.1.1): у шлюза нет синтеза речи и нет таймкодов транскрипции,
# поэтому он применим только к переводу.
kilo_gateway:
  api_key_env: KILO_API_KEY
  endpoint: https://api.kilocode.ai/api/openrouter
  timeout_ms: 120000
  max_retries: 3
  api_key_file: null         # запасной путь к файлу с токеном, если переменная не задана

# --- S2. Распознавание речи --------------------------------------------------
asr:
  engine: whisper-cpp        # единственный движок распознавания
  model: small               # tiny | base | small | medium | large-v3
  device: cpu
  language: en
  threads: null              # null = по числу ядер
  endpoint: null
  api_key_env: null
  vad:
    enabled: true            # уточнение границ реплик (ТЗ FR-2)
    window_ms: 400
    model: ggml-silero-v5.1.2
  diarization:
    enabled: true            # при недоступности модели — деградация до speaker_0
    engine: pyannote         # pyannote (Python + PyTorch, локально) | none
    model: pyannote/speaker-diarization-community-1
    max_speakers: 4
    hf_token_env: HF_TOKEN   # имя переменной с токеном Hugging Face (нужен один раз, для загрузки весов)

# --- S3. Перевод -------------------------------------------------------------
translate:
  engine: kilo-gateway       # kilo-gateway | ollama (задаётся профилем)
  model: anthropic/claude-sonnet-4.5
    # Имена у движков разные и не пересекаются: `anthropic/claude-sonnet-4.5` у
    # шлюза, `qwen3:8b` у Ollama (как в `ollama list`). При profile: offline имя
    # подставляется само из fallback_model, если вы не выбрали своё.
    # Встроенную видеокарту Ollama по умолчанию не берёт — нужна переменная
    # окружения OLLAMA_IGPU_ENABLE=1, см. README.
  fallback_engine: ollama    # куда деградировать при недоступности шлюза
  fallback_model: qwen2.5:7b-instruct
  ollama_endpoint: http://127.0.0.1:11434
  batch_size: 10             # 8–12 реплик за запрос (ТЗ §3.4)
  profanity: soft            # soft | hard | keep
  chars_per_second: 11.5     # темп речи для контроля длины (ТЗ FR-3).
                             # Величина приблизительная: один и тот же голос
                             # произносит разные фразы со скоростью 9–14 симв/с.
                             # Фактический темп прогона S5 пишет в calibration.json
  length_tolerance: 0.15
  length_tolerance_floor_ms: 250   # на коротких слотах ±15% недостижимы физически
  fit_length_pass: true      # корректирующий проход по репликам вне допуска
  context_segments: 3
  review:                    # финальная рецензия перевода: один проход по всему фильму
    enabled: false           # выключена: это ещё один проход размером с сам перевод
    model: null              # null — та же модель, что переводила
    batch_lines: 400         # сколько реплик за заход; эпизод целиком лучше, чем по частям
    overlap_lines: 10        # нахлёст на стыке заходов, чтобы не терять связь сцен
    checks:                  # что именно проверять
      gender: true           # род глаголов по полу говорящего, замеренному на S2
      glossary: true         # имена и термины по глоссарию, включая падежи
      address: true          # «ты» и «вы» одинаково у одной пары героев
      consistency: true      # единообразие терминов и манеры речи
      meaning: true          # смысловые ошибки и недопереведённые куски
      length: true           # переписать то, что не влезает в своё время
    max_changes_share: 0.5   # переписала больше половины — это новый перевод, а не правка;
                             # такая рецензия отбрасывается целиком
    allow_worse_fit: false   # принимать ли правку, которая укладывается хуже прежней.
                             # На реальном эпизоде предохранитель отклонил 27 правок из 46
    temperature: 0.2

# --- S5. Синтез речи ---------------------------------------------------------
tts:
  engine: piper              # piper | silero  (kilo-gateway невозможен, ТЗ §3.1.1)
    # silero — 29 русских дикторов в одной модели на 92 МБ, из них 16 женских, и
    # героине подбирается голос её собственной высоты, а не «женский вообще».
    # Синтезирует в пятнадцать раз быстрее piper, но требует Python с torch.
    # Имена голосов у движков разные и не пересекаются: ru_RU-irina-medium у
    # piper, ru_zhadyra у silero — меняя движок, поменяйте и default_voice.
  model: null
  default_voice: ru_RU-irina-medium
  voice_map: {}
    # Голос на спикера (ТЗ FR-5). Пусто — голоса раздаются по полу, определённому
    # на S2, а поправить их можно в панели «Голоса и персонажи» для конкретного
    # видео. Вписывать сюда `speaker_0` не стоит: в разных фильмах это разные
    # люди, а вписанный голос сильнее определённого пола — мужской голос
    # достанется женщине и наоборот.
  endpoint: null
  api_key_env: null
  concurrency: 2
  sample_rate: 48000

# --- S4. Отделение голоса от фона -------------------------------------------
separation:
  enabled: false             # выключено по умолчанию: дорого по времени на CPU
  engine: mdx-onnx           # единственный движок разделения
  model: UVR-MDX-NET-Inst_HQ_3
  fallback_to_ducking: true  # нет разделителя — приглушаем оригинал (ТЗ FR-4)

# --- S6. Подгонка по таймкодам ----------------------------------------------
alignment:
  enabled: true
  min_tempo: 0.9
  max_tempo: 1.25
  max_retranslate: 2
  gap_ms: 50
  max_shift_ms: 1500         # предел сдвига реплики вправо (ТЗ FR-6.5)
  drift_reset_gap_ms: 700    # пауза, на которой накопленный сдвиг обнуляется

# --- Субтитры ----------------------------------------------------------------
subtitles:
  max_line_chars: 42      # символов в строке
  max_lines: 2            # строк в титре
  min_duration_ms: 1000   # минимальная длительность титра
  max_duration_ms: 7000   # максимальная длительность титра
  gap_ms: 84              # зазор между соседними титрами (2 кадра при 24 к/с)
  max_cps: 17             # предел скорости чтения, символов в секунду

# --- S7. Сведение ------------------------------------------------------------
mix:
  background_gain_db: -6
  voice_gain_db: 0
  loudnorm: true
  loudnorm_target_lufs: -16
  duck_db: -18               # приглушение оригинала при выключенной S4
  duck_fade_ms: 120

# --- Кэш ---------------------------------------------------------------------
cache:
  enabled: true
  dir: .dubpipe
  keep_intermediate: false   # оставлять черновые дорожки сведения (голос, огибающая,
                             # сведённое и нормализованное). После мультиплексирования
                             # они не нужны: звук уже в готовом файле, а стадия сведения
                             # из кэша не берётся и соберёт их заново. На 15-минутном
                             # эпизоде это 585 МБ. Включайте, когда разбираетесь со звуком
